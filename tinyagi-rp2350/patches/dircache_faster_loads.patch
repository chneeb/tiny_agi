+		panic("Failed to open VOL file '%s'", path);
+	}
+
 	uint8_t size_buf[2];
-	read_file_at(path, res_pos.offset + 3, size_buf, 2);
+	file_read_at(fh, res_pos.offset + 3, size_buf, 2);
 
 	vol_data_t result;
 	result.size = size_buf[0] | (size_buf[1] << 8);
 
 	result.buffer = malloc(result.size + (is_logic ? 1 : 0));
 	if (result.buffer) {
-		read_file_at(path, res_pos.offset + 5, result.buffer, result.size);
+		file_read_at(fh, res_pos.offset + 5, result.buffer, result.size);
 	} else {
+		file_close(fh);
 		panic("Failed to allocate memory for resource");
 	}
 
+	file_close(fh);
 	return result;
 }
 
