diff --git a/tinyagi-rp2350/sdcard.c b/tinyagi-rp2350/sdcard.c
index 4d640fc..d6fac43 100644
--- a/tinyagi-rp2350/sdcard.c
+++ b/tinyagi-rp2350/sdcard.c
@@ -120,6 +120,32 @@ size_t sd_read_file_at(const char *path, size_t offset, void *buf, size_t len)
     return (size_t)br;
 }
 
+void *sd_file_open(const char *path)
+{
+    FIL *fil = malloc(sizeof(FIL));
+    if (!fil) return NULL;
+    if (f_open(fil, path, FA_READ) != FR_OK) { free(fil); return NULL; }
+    return fil;
+}
+
+size_t sd_file_read_at(void *handle, size_t offset, void *buf, size_t len)
+{
+    if (!handle) return 0;
+    FIL *fil = (FIL *)handle;
+    f_lseek(fil, (FSIZE_t)offset);   // seeking to the current position is a cheap no-op
+    UINT br = 0;
+    f_read(fil, buf, (UINT)len, &br);
+    return (size_t)br;
+}
+
+void sd_file_close(void *handle)
+{
+    if (!handle) return;
+    FIL *fil = (FIL *)handle;
+    f_close(fil);
+    free(fil);
+}
+
 static FIL save_fil;
 static bool save_is_open = false;
 
