 	char path[8];
 	sprintf(path, "vol.%d", res_pos.vol_number);
 
-	// Read only the 2-byte size header from the VOL file instead of loading it all.
+	// Open the VOL file once and read both the 2-byte size header and the data
+	// from the same handle — avoids a second f_open + FAT-walk per resource.
+	agi_fh_t* fh = file_open(path);
