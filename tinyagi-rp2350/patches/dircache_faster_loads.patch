diff --git a/agi/src/vol.c b/agi/src/vol.c
index 7066c16..ac6875b 100644
--- a/agi/src/vol.c
+++ b/agi/src/vol.c
@@ -10,13 +10,61 @@ typedef struct {
 	uint32_t offset;
 } resPos_t;
 
+/* Directory-file cache.
+ * AGI resolves every resource load by reading a whole dir file (logdir / picdir
+ * / viewdir / snddir) just to fetch a 3-byte entry, then discarding it — so a
+ * single room load re-reads the same small dir file many times from the SD card.
+ * The dir files are few (4) and static for a given game, so cache them in RAM:
+ * each is read from SD at most once per game.  This slashes per-transition SD
+ * traffic, which on the RP2350 DVI target is critical — core0 SD activity was
+ * starving core1's real-time DVI feed and dropping the video signal.
+ * The cache is reset on game switch (vol_cache_reset(), called by heap_full_reset). */
+#define DIR_CACHE_N 4
+static struct {
+	char       name[16];
+	agi_file_t file;      /* file.data == NULL => empty slot */
+} dir_cache[DIR_CACHE_N];
+
+static agi_file_t _get_dir_cached(const char* dir_filename) {
+	for (int i = 0; i < DIR_CACHE_N; i++) {
+		if (dir_cache[i].file.data && strcmp(dir_cache[i].name, dir_filename) == 0) {
+			return dir_cache[i].file;
+		}
+	}
+	/* miss: read from SD and store in a free slot (do NOT free — it stays cached) */
+	agi_file_t f = get_file(dir_filename);
+	if (f.data) {
+		for (int i = 0; i < DIR_CACHE_N; i++) {
+			if (!dir_cache[i].file.data) {
+				strncpy(dir_cache[i].name, dir_filename, sizeof(dir_cache[i].name) - 1);
+				dir_cache[i].name[sizeof(dir_cache[i].name) - 1] = '\0';
+				dir_cache[i].file = f;
+				break;
+			}
+		}
+		/* With only 4 distinct dir files and DIR_CACHE_N == 4 a slot always
+		 * exists; if it somehow didn't, f is returned uncached (small leak). */
+	}
+	return f;
+}
+
+void vol_cache_reset(void) {
+	for (int i = 0; i < DIR_CACHE_N; i++) {
+		if (dir_cache[i].file.data) {
+			free_file(dir_cache[i].file);
+			dir_cache[i].file.data = NULL;
+			dir_cache[i].file.size = 0;
+			dir_cache[i].name[0] = '\0';
+		}
+	}
+}
+
 resPos_t _find_res_offset(const char* dir_filename, const uint8_t res_no) {
-	agi_file_t dir_file = get_file(dir_filename);
+	agi_file_t dir_file = _get_dir_cached(dir_filename);   /* cached — must NOT free */
 
 	unsigned int offset = res_no * 3;
 
-	if (offset >= dir_file.size) {
-		free_file(dir_file);
+	if (!dir_file.data || offset >= dir_file.size) {
 		panic("Directory file offset out of bounds for file '%s', resource no %d", dir_filename, res_no);
 	}
 
@@ -24,8 +72,6 @@ resPos_t _find_res_offset(const char* dir_filename, const uint8_t res_no) {
 	uint8_t b = *(dir_file.data + offset + 1);
 	uint8_t c = *(dir_file.data + offset + 2);
 
-	free_file(dir_file);
-
 	uint32_t entry = (a << 16) | (b << 8) | c;
 	return (resPos_t) { .vol_number = a >> 4, .offset = entry & 0xFFFFF };
 }
